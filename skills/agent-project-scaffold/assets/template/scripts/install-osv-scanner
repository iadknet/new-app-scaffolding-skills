#!/bin/sh
set -eu

version=2.4.0
base_url=https://github.com/google/osv-scanner/releases/download/v$version

platform_values() {
  platform_os=$1
  platform_arch=$2
  case $platform_os in
    Darwin) archive_os=darwin ;;
    Linux) archive_os=linux ;;
    *) printf 'install-osv-scanner: unsupported operating system: %s\n' "$platform_os" >&2; return 1 ;;
  esac
  case $platform_arch in
    arm64|aarch64) archive_arch=arm64 ;;
    x86_64|amd64) archive_arch=amd64 ;;
    *) printf 'install-osv-scanner: unsupported architecture: %s\n' "$platform_arch" >&2; return 1 ;;
  esac
  archive=osv-scanner_${archive_os}_${archive_arch}
  case $archive in
    osv-scanner_darwin_amd64) expected_sha=088119325156321c34c456ac3703d6013538fd71cbac82b891ab34db491e4d66 ;;
    osv-scanner_darwin_arm64) expected_sha=9ca3185ad63e9ab54f7cb90f46a7362be02d80e37f0123d095a54355ea202f5d ;;
    osv-scanner_linux_amd64) expected_sha=15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0 ;;
    osv-scanner_linux_arm64) expected_sha=44e580752910f0ff36ec99aff59af20f65df1e859aa31e5605a8f0d055b496e9 ;;
  esac
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf 'install-osv-scanner: sha256sum or shasum is required\n' >&2
    return 1
  fi
}

if [ "${1:-}" = --print-platform ]; then
  [ "$#" -eq 3 ] || { printf 'Usage: scripts/install-osv-scanner --print-platform <uname-s> <uname-m>\n' >&2; exit 2; }
  platform_values "$2" "$3"
  printf '%s %s\n' "$archive" "$expected_sha"
  exit 0
fi
[ "$#" -eq 0 ] || { printf 'Usage: scripts/install-osv-scanner [--print-platform <uname-s> <uname-m>]\n' >&2; exit 2; }

target=.tools/bin/osv-scanner
if [ -x "$target" ] && "$target" --version 2>/dev/null | grep -Fq "$version"; then
  printf 'OSV-Scanner %s is already installed.\n' "$version"
  exit 0
fi

platform_values "$(uname -s)" "$(uname -m)"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/osv-scanner.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
download=$tmp_dir/$archive
curl -fL --retry 3 -o "$download" "$base_url/$archive"
actual_sha=$(sha256_file "$download")
[ "$actual_sha" = "$expected_sha" ] || {
  printf 'install-osv-scanner: checksum mismatch for %s\nexpected: %s\nactual:   %s\n' "$archive" "$expected_sha" "$actual_sha" >&2
  exit 1
}

mkdir -p .tools/bin
mv "$download" "$target"
chmod 0755 "$target"
"$target" --version
