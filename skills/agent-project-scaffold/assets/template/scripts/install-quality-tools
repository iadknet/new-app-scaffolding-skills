#!/bin/sh
set -eu

actionlint_version=1.7.12
shellcheck_version=0.11.0
actionlint_base=https://github.com/rhysd/actionlint/releases/download/v$actionlint_version
shellcheck_base=https://github.com/koalaman/shellcheck/releases/download/v$shellcheck_version

platform_values() {
  platform_os=$1
  platform_arch=$2
  case $platform_os in
    Darwin) archive_os=darwin ;;
    Linux) archive_os=linux ;;
    *) printf 'install-quality-tools: unsupported operating system: %s\n' "$platform_os" >&2; return 1 ;;
  esac
  case $platform_arch in
    arm64|aarch64)
      actionlint_arch=arm64
      shellcheck_arch=aarch64
      ;;
    x86_64|amd64)
      actionlint_arch=amd64
      shellcheck_arch=x86_64
      ;;
    *) printf 'install-quality-tools: unsupported architecture: %s\n' "$platform_arch" >&2; return 1 ;;
  esac

  actionlint_archive=actionlint_${actionlint_version}_${archive_os}_${actionlint_arch}.tar.gz
  shellcheck_archive=shellcheck-v${shellcheck_version}.${archive_os}.${shellcheck_arch}.tar.gz
  case $archive_os:$actionlint_arch in
    darwin:arm64) actionlint_sha=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f ;;
    darwin:amd64) actionlint_sha=5b44c3bc2255115c9b69e30efc0fecdf498fdb63c5d58e17084fd5f16324c644 ;;
    linux:arm64) actionlint_sha=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 ;;
    linux:amd64) actionlint_sha=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 ;;
  esac
  case $archive_os:$shellcheck_arch in
    darwin:aarch64) shellcheck_sha=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f ;;
    darwin:x86_64) shellcheck_sha=c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51 ;;
    linux:aarch64) shellcheck_sha=68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc ;;
    linux:x86_64) shellcheck_sha=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6 ;;
  esac
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf 'install-quality-tools: sha256sum or shasum is required\n' >&2
    return 1
  fi
}

if [ "${1:-}" = --print-platform ]; then
  [ "$#" -eq 3 ] || { printf 'Usage: scripts/install-quality-tools --print-platform <uname-s> <uname-m>\n' >&2; exit 2; }
  platform_values "$2" "$3"
  printf 'actionlint %s %s\n' "$actionlint_archive" "$actionlint_sha"
  printf 'shellcheck %s %s\n' "$shellcheck_archive" "$shellcheck_sha"
  exit 0
fi
[ "$#" -eq 0 ] || { printf 'Usage: scripts/install-quality-tools [--print-platform <uname-s> <uname-m>]\n' >&2; exit 2; }

actionlint_target=.tools/bin/actionlint
shellcheck_target=.tools/bin/shellcheck
actionlint_ready=0
shellcheck_ready=0
if [ -x "$actionlint_target" ] && "$actionlint_target" -version 2>/dev/null | grep -Fq "$actionlint_version"; then
  actionlint_ready=1
fi
if [ -x "$shellcheck_target" ] && "$shellcheck_target" --version 2>/dev/null | grep -Fq "version: $shellcheck_version"; then
  shellcheck_ready=1
fi
if [ "$actionlint_ready" -eq 1 ] && [ "$shellcheck_ready" -eq 1 ]; then
  printf 'actionlint %s and ShellCheck %s are already installed.\n' "$actionlint_version" "$shellcheck_version"
  exit 0
fi

platform_values "$(uname -s)" "$(uname -m)"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/quality-tools.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
actionlint_download=$tmp_dir/$actionlint_archive
shellcheck_download=$tmp_dir/$shellcheck_archive

curl -fL --retry 3 -o "$actionlint_download" "$actionlint_base/$actionlint_archive"
actual_sha=$(sha256_file "$actionlint_download")
[ "$actual_sha" = "$actionlint_sha" ] || {
  printf 'install-quality-tools: checksum mismatch for %s\nexpected: %s\nactual:   %s\n' "$actionlint_archive" "$actionlint_sha" "$actual_sha" >&2
  exit 1
}

curl -fL --retry 3 -o "$shellcheck_download" "$shellcheck_base/$shellcheck_archive"
actual_sha=$(sha256_file "$shellcheck_download")
[ "$actual_sha" = "$shellcheck_sha" ] || {
  printf 'install-quality-tools: checksum mismatch for %s\nexpected: %s\nactual:   %s\n' "$shellcheck_archive" "$shellcheck_sha" "$actual_sha" >&2
  exit 1
}

tar -xzf "$actionlint_download" -C "$tmp_dir" actionlint
tar -xzf "$shellcheck_download" -C "$tmp_dir" "shellcheck-v$shellcheck_version/shellcheck"
mkdir -p .tools/bin
mv "$tmp_dir/actionlint" "$actionlint_target"
mv "$tmp_dir/shellcheck-v$shellcheck_version/shellcheck" "$shellcheck_target"
chmod 0755 "$actionlint_target" "$shellcheck_target"
"$actionlint_target" -version
"$shellcheck_target" --version
