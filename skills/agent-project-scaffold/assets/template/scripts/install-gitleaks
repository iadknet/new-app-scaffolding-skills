#!/bin/sh
set -eu

version=8.30.1
base_url=https://github.com/gitleaks/gitleaks/releases/download/v$version

platform_values() {
  platform_os=$1
  platform_arch=$2
  case $platform_os in
    Darwin) archive_os=darwin ;;
    Linux) archive_os=linux ;;
    *) printf 'install-gitleaks: unsupported operating system: %s\n' "$platform_os" >&2; return 1 ;;
  esac
  case $platform_arch in
    arm64|aarch64) archive_arch=arm64 ;;
    x86_64|amd64) archive_arch=x64 ;;
    *) printf 'install-gitleaks: unsupported architecture: %s\n' "$platform_arch" >&2; return 1 ;;
  esac
  case $archive_os:$archive_arch in
    darwin:arm64) expected_sha=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
    darwin:x64) expected_sha=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709 ;;
    linux:arm64) expected_sha=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
    linux:x64) expected_sha=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
  esac
  archive=gitleaks_${version}_${archive_os}_${archive_arch}.tar.gz
}

if [ "${1:-}" = --print-platform ]; then
  [ "$#" -eq 3 ] || { printf 'Usage: scripts/install-gitleaks --print-platform <uname-s> <uname-m>\n' >&2; exit 2; }
  platform_values "$2" "$3"
  printf '%s %s\n' "$archive" "$expected_sha"
  exit 0
fi
[ "$#" -eq 0 ] || { printf 'Usage: scripts/install-gitleaks [--print-platform <uname-s> <uname-m>]\n' >&2; exit 2; }

target=.tools/bin/gitleaks
if [ -x "$target" ] && "$target" version 2>/dev/null | grep -Fq "$version"; then
  printf 'Gitleaks %s is already installed.\n' "$version"
  exit 0
fi

platform_values "$(uname -s)" "$(uname -m)"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/gitleaks.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
download=$tmp_dir/$archive
curl -fL --retry 3 -o "$download" "$base_url/$archive"

if command -v sha256sum >/dev/null 2>&1; then
  actual_sha=$(sha256sum "$download" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  actual_sha=$(shasum -a 256 "$download" | awk '{print $1}')
else
  printf 'install-gitleaks: sha256sum or shasum is required\n' >&2
  exit 1
fi
[ "$actual_sha" = "$expected_sha" ] || {
  printf 'install-gitleaks: checksum mismatch for %s\nexpected: %s\nactual:   %s\n' "$archive" "$expected_sha" "$actual_sha" >&2
  exit 1
}

tar -xzf "$download" -C "$tmp_dir" gitleaks
mkdir -p .tools/bin
mv "$tmp_dir/gitleaks" "$target"
chmod 0755 "$target"
"$target" version
