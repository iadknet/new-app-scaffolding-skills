#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { printf 'Usage: scripts/secret-scan <staged|history>\n' >&2; exit 2; }
scanner=.tools/bin/gitleaks
[ -x "$scanner" ] || { printf 'secret-scan: run make setup first\n' >&2; exit 1; }
case $1 in
  staged) exec "$scanner" git --staged --redact --no-banner . ;;
  history) exec "$scanner" git --redact --no-banner . ;;
  *) printf 'Usage: scripts/secret-scan <staged|history>\n' >&2; exit 2 ;;
esac
