#!/bin/sh
set -eu

for workflow in .github/workflows/*.yml .github/workflows/*.yaml; do
  [ -f "$workflow" ] || continue
  grep -Eq '^permissions:$' "$workflow" || {
    printf 'policy-check: %s lacks explicit permissions\n' "$workflow" >&2
    exit 1
  }
  grep -Eq '^  contents: read$' "$workflow" || {
    printf 'policy-check: %s must use read-only contents permission\n' "$workflow" >&2
    exit 1
  }
  if awk '
    {
      normalized = $0
      gsub(/"/, "", normalized)
      gsub(sprintf("%c", 39), "", normalized)
      if ($0 ~ /^[^[:space:]]/ && normalized ~ /permissions[[:space:]]*:/ && $0 !~ /^permissions:[[:space:]]*(#.*)?$/) unsafe = 1
    }
    /^permissions:[[:space:]]*(#.*)?$/ { in_permissions = 1; permission_blocks++; next }
    in_permissions && /^[[:space:]]*($|#)/ { next }
    in_permissions && /^[^[:space:]]/ { in_permissions = 0 }
    in_permissions {
      line = $0
      sub(/[[:space:]]*#.*/, "", line)
      if (line !~ /^  [A-Za-z-]+:[[:space:]]*/) {
        unsafe = 1
        next
      }
      value = line
      sub(/^  [A-Za-z-]+:[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      if (value != "read" && value != "none") unsafe = 1
    }
    END { exit permission_blocks != 1 || unsafe ? 0 : 1 }
  ' "$workflow"; then
    printf 'policy-check: %s contains a non-read or non-canonical workflow permission\n' "$workflow" >&2
    exit 1
  fi
  if awk '
    function indentation(text, i) {
      for (i = 1; i <= length(text); i++) {
        if (substr(text, i, 1) != " ") return i - 1
      }
      return length(text)
    }
    /^[[:space:]]*($|#)/ { next }
    {
      indent = indentation($0)
      text = substr($0, indent + 1)
      normalized = text
      gsub(/"/, "", normalized)
      gsub(sprintf("%c", 39), "", normalized)
      if (!in_jobs) {
        if (indent == 0 && normalized ~ /^jobs:[[:space:]]*(#.*)?$/) {
          in_jobs = 1
          job_indent = -1
        } else if (indent == 0 && normalized ~ /^jobs[[:space:]]*:/) {
          found = 1
        }
        next
      }
      if (indent == 0) {
        in_jobs = 0
        next
      }
      if (job_indent < 0) job_indent = indent
      if (indent == job_indent) {
        if (normalized ~ /[{,][[:space:]]*permissions[[:space:]]*:/) found = 1
        property_indent = -1
        next
      }
      if (indent > job_indent) {
        if (property_indent < 0 || indent < property_indent) property_indent = indent
        if (indent == property_indent && normalized ~ /^permissions[[:space:]]*:/) found = 1
      }
    }
    END { exit found ? 0 : 1 }
  ' "$workflow"; then
    printf 'policy-check: %s contains job-level permissions that override the read-only workflow policy\n' "$workflow" >&2
    exit 1
  fi
  sed -n 's/^[[:space:]]*-\{0,1\}[[:space:]]*uses:[[:space:]]*\([^ #]*\).*/\1/p' "$workflow" |
    while IFS= read -r action; do
      printf '%s\n' "$action" | grep -Eq '@[0-9a-f]{40}$' || {
        printf 'policy-check: %s contains an unpinned action: %s\n' "$workflow" "$action" >&2
        exit 1
      }
    done
done
