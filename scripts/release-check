#!/bin/sh
set -eu

usage() {
  printf 'Usage: release-check v<major>.<minor>.<patch>\n' >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
printf '%s\n' "$1" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || usage

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

[ "$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" = main ] || {
  printf 'release-check: releases must be prepared from main\n' >&2
  exit 1
}
[ -z "$(git status --porcelain)" ] || {
  printf 'release-check: working tree must be clean\n' >&2
  exit 1
}

grep -Eq "^## \[$1\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" CHANGELOG.md || {
  printf 'release-check: generate and commit the %s changelog section first\n' "$1" >&2
  exit 1
}

[ "$(git log -1 --format=%s)" = "chore: prepare $1" ] || {
  printf 'release-check: HEAD must be the dedicated "chore: prepare %s" commit\n' "$1" >&2
  exit 1
}
[ "$(git diff-tree --no-commit-id --name-only -r HEAD)" = CHANGELOG.md ] || {
  printf 'release-check: the release preparation commit must change only CHANGELOG.md\n' >&2
  exit 1
}

previous_tag=$(git tag --merged HEAD^ --list 'v[0-9]*' --sort=-version:refname | head -n 1)
if [ -n "$previous_tag" ]; then
  range=$previous_tag..HEAD^
else
  range=HEAD^
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/release-check.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
git log --no-merges --format='%h' "$range" | sort >"$tmp/expected"
awk -v version="$1" '
  $0 ~ "^## \\[" version "\\] - " { in_release = 1; next }
  in_release && /^## \[/ { exit }
  in_release {
    line = $0
    while (match(line, /`[0-9a-f]+`/)) {
      print substr(line, RSTART + 1, RLENGTH - 2)
      line = substr(line, RSTART + RLENGTH)
    }
  }
' CHANGELOG.md | sort >"$tmp/actual"

cmp -s "$tmp/expected" "$tmp/actual" || {
  printf 'release-check: the %s changelog section must list every non-merge commit in %s exactly once\n' "$1" "$range" >&2
  printf 'Expected commit hashes:\n' >&2
  cat "$tmp/expected" >&2
  printf 'Recorded commit hashes:\n' >&2
  cat "$tmp/actual" >&2
  exit 1
}

make check
make test-integration
make test-distribution

printf 'Release checks passed for %s.\n' "$1"
