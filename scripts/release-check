#!/bin/sh
set -eu

usage() {
  printf 'Usage: release-check v<major>.<minor>.<patch>\n' >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
printf '%s\n' "$1" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || usage

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

[ "$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" = main ] || {
  printf 'release-check: releases must be prepared from main\n' >&2
  exit 1
}
[ -z "$(git status --porcelain)" ] || {
  printf 'release-check: working tree must be clean\n' >&2
  exit 1
}

grep -Eq "^## \[$1\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" CHANGELOG.md || {
  printf 'release-check: generate and commit the %s changelog section first\n' "$1" >&2
  exit 1
}

make check
make test-integration
make test-distribution

printf 'Release checks passed for %s.\n' "$1"
